# Keep the published image small and free of anything not needed at runtime.
# Without this file `COPY . .` bakes .git and every local .env into a public image.
.git
.github
.gitignore
.venv
venv
.pytest_cache
__pycache__/
**/__pycache__/
*.pyc
*.log
tests
docs
db

# Operator-mounted secret override must never be baked in; the bundled
# config/defaults.env is deliberately NOT excluded (see README, Database).
.env
config/db.env
