# Non-secret connection parameters for the PATATERNO container.
# Committed on purpose and shipped inside the image.
#
# There is deliberately NO DB_PASSWORD here. The AGRARIAN Database Guide
# (section 5, "Connecting via Code") requires credentials to come from
# environment variables or a .env file, never from source:
#
#     "Never hardcode your database credentials directly into your source
#      code. Always use Environment Variables (e.g., .env files)."
#
# Supply the credential at run time, in any of these ways (later wins):
#   - a git-ignored `.env` in the repo root          (local development)
#   - the DB_PASSWORD environment variable           (docker run -e ...)
#   - a file mounted at /app/config/db.env           (portal / Kubernetes)
#
# Without it the container still starts and still reports reachability:
# /dbcheck runs its credential-free TCP stage and returns
# verdict "no_credentials", which is enough to prove routing.
DB_HOST=10.160.101.65
DB_PORT=5432
DB_NAME=pataterno_db
DB_USER=pataterno
DB_SCHEMA=dev
