# Template for the credential file. Copy, fill in, and place it either at
#   - <repo>/.env                 for local development (git-ignored), or
#   - /app/config/db.env          mounted into the running container.
#
# Never commit the filled-in version. The password is the 16-character string
# from the AGRARIAN onboarding email (also in `tech/VPN portal/readme.txt`).
DB_PASSWORD=

